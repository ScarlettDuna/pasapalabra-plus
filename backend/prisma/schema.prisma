// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
  language String // ES | EN | FR
  type     String // theme | learning

  questions Question[]
  games     Game[]

  @@unique([name, language, type])
}

model Question {
  id         String @id @default(uuid())
  letter     String
  question   String
  answer     String
  language   String // ES | EN | FR
  difficulty String // easy | medium | hard

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  status    String  @default("approved")
  isPersonal  Boolean   @default(false)
  createdBy   String?   
  creator     User?     @relation(fields: [createdBy], references: [id])
  answers     GameAnswer[]

  @@unique([letter, language, difficulty, categoryId, question])
  @@index([language, difficulty])
  @@index([letter])
}

enum GameStatus {
  active
  finished
  abandoned
}

model Game {
  id         String @id @default(uuid())
  language   String // ES | EN | FR
  difficulty String // easy | medium | hard

  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  
  userId     String?
  user       User? @relation(fields: [userId], references: [id])
  
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  duration   Int?
  
  score      Score?
  answers    GameAnswer[]
  status     GameStatus @default(active) // 'active' | 'finished' | 'abandoned'
  
  @@index([language, difficulty, categoryId])
}

model Score {
  id        String   @id @default(uuid())
  correct   Int
  wrong     Int
  duration  Int
  score     Int
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String?
  createdAt     DateTime @default(now())
  role          String   @default("user")
  createdQuestions    Question[]

  games         Game[]
  achievement   UserAchievement[]
  refreshTokens    RefreshToken[]  
}

model GameAnswer {
  id            String    @id @default(uuid())
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id])
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])
  letter        String
  isCorrect     Boolean
}

model UserAchievement {
  id          String      @id @default(uuid())
  userId      String      
  user        User        @relation(fields: [userId], references: [id])
  achievement String
  unlockedAt  DateTime    @default(now())
  revokedAt   DateTime?

  @@index([userId, achievement])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}